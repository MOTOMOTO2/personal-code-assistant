{
  "name": "personal-code-assistant",
  "version": "0.1.0",
  "description": "A local, trainable ML coding assistant: from-scratch models that learn your codebase, a chat you can message from your phone, and training that folds every answer back in.",
  "type": "module",
  "bin": {
    "pca": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "pca": "node dist/cli.js"
  },
  "keywords": [
    "machine-learning",
    "code-completion",
    "language-model",
    "claude",
    "developer-tools",
    "chat",
    "local-first",
    "self-hosted",
    "mobile"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
